[build-system]
requires = ["hatchling"]
build-backend = "hatchling.build"

[project]
name = "{{ project_slug }}"
version = "0.1.0"
description = "{{ description }}"
readme = { file = "README.org", content-type = "text/plain" }
requires-python = ">={{ python_version }}"
authors = [{ name = "{{ author_name }}" }]
dependencies = []

[dependency-groups]
dev = ["pytest>=8"]

[tool.pytest.ini_options]
testpaths = ["tests"]
