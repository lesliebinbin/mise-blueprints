[tools]
python = "{{ python_version }}"
uv = "latest"

[env]
_.path = ["{{ '{{config_root}}' }}/openusd/build/bin"]
QT_QPA_PLATFORM="xcb"

[settings]
python.uv_venv_auto = "create|source"

[tasks.setup]
description = "Clone upstream openusd"
run = """
set -eu
git clone git@github.com:lesliebinbin/OpenUSD.git openusd
if [ ! -f pyproject.toml ]; then
    uv init --bare --python {{ python_version }} .
fi
"""


[tasks.build]
description = "Build OpenUSD and expose its Python bindings"
run = """
set -eu
(
    cd openusd
    uv sync --python {{ python_version }}
    uv run --python {{ python_version }} build_usd build
)
bindings="$PWD/openusd/build/lib/python{{ python_version }}/site-packages"
test -d "$bindings/pxr"
site_packages="$(uv run --python {{ python_version }} python -c 'import sysconfig; print(sysconfig.get_path("purelib"))')"
printf '%s\n' "$bindings" > "$site_packages/openusd-bindings.pth"
"""

[tasks.check]
description = "Check the OpenUSD Python bindings"
run = "uv run --python {{ python_version }} python -E -c 'from pxr import Usd; stage = Usd.Stage.CreateInMemory(); stage.DefinePrim(\"/World\"); assert stage.GetPrimAtPath(\"/World\"); print(Usd.GetVersion())'"
