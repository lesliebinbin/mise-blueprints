[tools]
node = "{{ node_version }}"

[tasks.setup]
description = "Install application dependencies"
run = "npm install"

[tasks.dev]
description = "Start the Vite development server"
run = "npm run dev"

[tasks.build]
description = "Build the application"
run = "npm run build"

[tasks.lint]
description = "Lint the application"
run = "npm run lint"

[tasks.check]
description = "Build and lint the application"
depends = ["build", "lint"]
