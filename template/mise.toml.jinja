[tools]
python = "{{ python_version }}"
uv = "latest"

[settings]
python.uv_venv_auto = "create|source"

[tasks.setup]
description = "Clone upstream openusd"
run = """
#!/usr/bin/env bash
set -euo pipefail

if [ ! -f "package.json" ]; then
  echo "Fetching fly-connectome-template upstream repository..."
  tmp_dir=$(mktemp -d)
  git clone --depth 1 git@github.com:lesliebinbin/OpenUSD.git "$tmp_dir"
  rm -rf "$tmp_dir/.git" "$tmp_dir/.nvmrc"
  cp -rn "$tmp_dir"/* . 2>/dev/null || cp -r "$tmp_dir"/* .
  cp -rn "$tmp_dir"/.[!.]* . 2>/dev/null || true
  rm -rf "$tmp_dir"
fi
"""


[tasks.build]
description = "Build the application"
run = "uv run build_usd"

