[tools]
node = "{{ node_version }}"

[tasks.setup]
description = "Clone upstream fly-connectome-template and install dependencies"
run = """
#!/usr/bin/env bash
set -euo pipefail

if [ ! -f "package.json" ]; then
  echo "Fetching fly-connectome-template upstream repository..."
  tmp_dir=$(mktemp -d)
  git clone --depth 1 https://github.com/cobanov/fly-connectome-template.git "$tmp_dir"
  rm -rf "$tmp_dir/.git" "$tmp_dir/.nvmrc"
  cp -rn "$tmp_dir"/* . 2>/dev/null || cp -r "$tmp_dir"/* .
  cp -rn "$tmp_dir"/.[!.]* . 2>/dev/null || true
  rm -rf "$tmp_dir"
fi

npm install
"""

[tasks.dev]
description = "Start the development server"
run = "npm run dev"

[tasks.build]
description = "Build the application"
run = "npm run build"

[tasks."check:assets"]
description = "Verify integrity of bundled anatomical data"
run = "npm run check:assets"

[tasks.test]
description = "Run tests"
run = "npm run test"

[tasks.check]
description = "Verify assets, run tests, and build"
depends = ["check:assets", "test", "build"]
